{
  "expo": {
    "name": "SyncOps",
    "slug": "syncops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "syncops",
    "primaryColor": "#2563EB",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.syncops.app",
      "buildNumber": "2",
      "requireFullScreen": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "SyncOps uses Face ID to confirm your identity before clocking in or out.",
        "NSLocationWhenInUseUsageDescription": "SyncOps uses your location at clock-in and clock-out to confirm you are on-site.",
        "NSLocationAlwaysUsageDescription": "SyncOps uses your location to verify you are at your assigned work site.",
        "NSCameraUsageDescription": "SyncOps may use your camera when attaching supporting documents to a leave request.",
        "NSPhotoLibraryUsageDescription": "SyncOps allows you to attach photos as supporting documents for leave requests.",
        "UIBackgroundModes": [],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.syncops.app",
      "versionCode": 2,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 23,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      },
      "allowBackup": false,
      "jsEngine": "hermes"
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SyncOps uses your location at clock-in and clock-out to confirm you are on-site.",
          "locationAlwaysAndWhenInUsePermission": "SyncOps uses your location to verify you are at your assigned work site."
        }
      ],
      "expo-secure-store",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://syncops-production-f5ac.up.railway.app/api",
      "eas": {
        "projectId": "0b956235-fdaf-4d14-9e5b-1a8b6f93d8d2"
      }
    }
  }
}
